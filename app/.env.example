# Copy to .env (or .env.local) — Expo exposes EXPO_PUBLIC_* to the app bundle.
# These are PUBLIC values (the anon key is safe to ship; RLS protects the data).
# Never put the Anthropic key or the Supabase service-role key here.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Local development with `supabase start` (use your machine's LAN IP for a physical phone):
# EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<printed by `supabase status`>
